# ============================================================
# CodeForGood Portfolio - Environment Variables Template
# ============================================================
# Copy this file to .env.local and fill in your values

# Development Tools
# -----------------
# Code editor for create-react-app error overlay
REACT_EDITOR=code

# ============================================================
# SECRETS POLICY
# ============================================================
# DO NOT store production secrets in .env files!
# Use a secret manager instead:
# - Doppler: https://doppler.com
# - Infisical: https://infisical.com
# - 1Password: https://1password.com/products/developer-tools
#
# See: supply-chain-security-fortification-plan.md

# Google Analytics (currently hardcoded in layout.tsx)
# NEXT_PUBLIC_GA_ID=G-K5XKE6L8VJ

# Future API Keys (use NEXT_PUBLIC_ prefix for client-side access)
# NEXT_PUBLIC_API_URL=
# API_SECRET_KEY= (server-side only, no NEXT_PUBLIC_ prefix)
